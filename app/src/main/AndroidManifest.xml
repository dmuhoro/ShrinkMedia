<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground Service & Notification Permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- On-device privacy invariant (AGENTS.md §2): the app declares NO INTERNET
         permission. ML Kit's telemetry backend (com.google.android.datatransport
         :transport-backend-cct) would merge android.permission.INTERNET into the
         shipped APK; it is stripped here so every operation runs on-device with no
         network permission. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Scoped storage & File sharing provider support -->
    <!-- ML Kit GenAI Prompt (Gemini Nano) + genai-common declare minSdk 26, but the app targets
         minSdk 24. We force the libraries (overrideLibrary) so they build in;
         OnDeviceInferenceRepository guards EVERY GenAI class touch behind
         Build.VERSION.SDK_INT >= 26 (returns API_TOO_OLD below), so the library classes are
         never loaded on 24-25 and no runtime failure can occur. -->
    <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt,com.google.mlkit.genai.common" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Service for Background Batch Compression -->
        <service
            android:name=".BatchCompressionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
